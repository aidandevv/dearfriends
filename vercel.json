{
  "installCommand": "pnpm install --frozen-lockfile --ignore-workspace",
  "buildCommand": "pnpm run check:deploy",
  "crons": [
    {
      "path": "/api/cron/send-verifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/send-calendar-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/anniversary-reminders",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/birthday-reminders",
      "schedule": "0 11 * * 1"
    }
  ]
}
